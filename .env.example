# Postgres (docker compose, host port 5433)
DATABASE_URL="postgresql://store:store@localhost:5433/store?schema=public"

# First admin, created by `pnpm db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Auth.js secret (generate with: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"

# Outgoing email (order notifications). Dev: Mailpit from docker compose
# (SMTP 1025, inbox UI http://localhost:8025). Leave SMTP_HOST empty to skip sending.
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Brand <no-reply@example.test>"
